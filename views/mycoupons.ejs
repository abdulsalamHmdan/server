<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>كوبونات السفير</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    :root {
      --bg-color: #f4f5f7;
      --card-bg: #ffffff;
      --primary-btn: #5c524d;
      --primary-light: #f5f3f1;
      --secondary-btn: #ffffff;
      --text-main: #2d3436;
      --text-muted: #636e72;
      --border-color: #edf2f7;
      --success-color: #2e7d32;
      --accent-color: #8b6b4d;
    }

    body {
      background:
        radial-gradient(900px 600px at 10% 0%, rgba(155, 217, 228, 0.35), transparent 60%),
        radial-gradient(900px 700px at 95% 15%, rgba(68, 49, 41, 0.14), transparent 55%),
        radial-gradient(1100px 700px at 50% 120%, rgba(0, 0, 0, 0.04), transparent 60%),
        var(--bg-color);
      margin: 0;
      padding: 30px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--text-main);
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 900px; /* عرض مناسب لصفحة الكوبونات */
      display: flex;
      flex-direction: column;
      gap: 25px;
    }

    /* رسالة الترحيب */
    .welcome-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px;
      text-align: center;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      border: 1px solid #fff;
      position: relative;
      overflow: hidden;
    }

    .welcome-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--primary-btn);
    }

    .welcome-title {
      font-size: 1.8rem;
      color: var(--primary-btn);
      margin: 0 0 10px 0;
    }

    .welcome-text {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin: 0;
      line-height: 1.6;
    }

    /* شبكة الكوبونات */
    .coupons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 20px;
    }

    /* تصميم بطاقة الكوبون */
    .coupon-card {
      background: linear-gradient(135deg, #ffffff 0%, #fdfbf9 100%);
      border: 2px solid #f1ede9;
      border-radius: 20px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
      position: relative;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s;
    }

    .coupon-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
    }

    /* ترويسة الكوبون (اسم الجهة والتاريخ) */
    .coupon-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
      padding-bottom: 15px;
      border-bottom: 1px dashed #d1c4b9;
    }

    .entity-name {
      font-size: 1.2rem;
      font-weight: bold;
      color: var(--accent-color);
      margin: 0;
    }

    .issue-date {
      font-size: 0.8rem;
      color: var(--text-muted);
      background: var(--primary-light);
      padding: 4px 10px;
      border-radius: 12px;
    }

    /* محتوى الكوبون (القيمة والـ QR) */
    .coupon-body {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .coupon-value-box {
      display: flex;
      flex-direction: column;
    }

    .value-label {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .value-tag {
      font-size: 2rem;
      font-weight: 900;
      color: var(--primary-btn);
      margin: 0;
    }

    .qr-wrapper {
      background: #fff;
      padding: 8px;
      border-radius: 12px;
      border: 1px solid #eee;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.02);
    }

    .qr-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* منطقة الكود والنسخ */
    .code-box {
      background: #fdfdfd;
      border: 2px dashed #d1c4b9;
      border-radius: 12px;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      direction: ltr; /* لجعل الكود الإنجليزي يقرأ من اليسار لليمين */
    }

    .coupon-code {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--text-main);
      letter-spacing: 2px;
      margin: 0;
    }

    .copy-btn {
      background: var(--primary-light);
      border: none;
      color: var(--primary-btn);
      padding: 8px 15px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      font-size: 0.9rem;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .copy-btn:hover {
      background: #e8e2dd;
    }

    /* تجاوب الشاشة (Responsive) */
    @media (max-width: 600px) {
      .coupons-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    
    <div class="welcome-card">
      <h1 class="welcome-title">أهلاً بك سفيرنا المعطاء: <span><%=coupons[0]?.user?.name%></span></h1>
      <p class="welcome-text">
        شكراً لجهودك العظيمة في دعم مشاريع المجمع. اليك قائمة بالكوبونات الخاصة بك.
      </p>
    </div>

    <div class="coupons-grid">
      <% if (coupons && coupons.length > 0) { %>
      <% coupons.forEach(coupon => { %>
      <div class="coupon-card">
        <div class="coupon-header">
          <h2 class="entity-name"><%=coupon.from%></h2>
          <span class="issue-date">تاريخ الصرف: <%=coupon.ExchangeDate.toLocaleDateString('ar-SA')%></span>
        </div>
        
        <div class="coupon-body">
          <div class="coupon-value-box">
            <span class="value-label">قيمة الكوبون</span>
            <span class="value-tag"><%=coupon.value%></span>
          </div>
          <div class="qr-wrapper">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%=coupon.code%>" alt="QR Code">
          </div>
        </div>

        <div class="code-box">
          <span class="coupon-code"><%=coupon.code%></span>
          <button class="copy-btn" onclick="copyCode(this, '<%=coupon.code%>')">نسخ</button>
        </div>
      </div>
        <% }) %>
        <% } else { %>
          <p style="text-align: center; color: var(--text-muted); font-size: 1.2rem;">لا توجد كوبونات متاحة حالياً</p>
        <% } %>



    </div>
  </div>

  <script>
    function copyCode(buttonElement, codeText) {
      // نسخ النص إلى الحافظة
      navigator.clipboard.writeText(codeText).then(() => {
        // تغيير نص الزر مؤقتاً للتأكيد للمستخدم
        const originalText = buttonElement.innerText;
        buttonElement.innerText = "تم النسخ!";
        buttonElement.style.background = "var(--success-color)";
        buttonElement.style.color = "#fff";
        
        // إعادة الزر لشكله الطبيعي بعد ثانيتين
        setTimeout(() => {
          buttonElement.innerText = originalText;
          buttonElement.style.background = "var(--primary-light)";
          buttonElement.style.color = "var(--primary-btn)";
        }, 2000);
      }).catch(err => {
        console.error('فشل في نسخ الكود: ', err);
      });
    }
  </script>
</body>
</html>